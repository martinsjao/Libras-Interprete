erDiagram
    NEON_AUTH_USER ||--|| PERFIS : "user_id"
    PERFIS ||--o{ AGENDAMENTOS : "user_id"

    NEON_AUTH_USER {
        text id PK
        text email
        text name
    }

    PERFIS {
        serial id PK
        text user_id UK
        text email UK
        text nome
        text papel
        timestamptz created_at
    }

    AGENDAMENTOS {
        serial id PK
        text user_id
        text tipo
        date data
        text horario
        text nome
        text email
        text telefone
        text observacoes
        timestamptz created_at
    }
